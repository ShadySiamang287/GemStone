# Doxygen configuration for the public GemStone engine API.

PROJECT_NAME           = "GemStone Engine"
PROJECT_NUMBER         = 0.1.0
PROJECT_BRIEF          = "A DirectX 12 test engine."

OUTPUT_DIRECTORY       = build/docs
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English

INPUT                  = README.md Engine/include
FILE_PATTERNS          = *.h *.hpp *.md
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */build/* */.git/*
USE_MDFILE_AS_MAINPAGE = README.md

GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES

# The initial public headers are not yet fully annotated. Extract their API
# declarations now, while keeping undocumented-member warnings quiet until
# documentation comments are added incrementally.
EXTRACT_ALL             = YES
WARN_IF_UNDOCUMENTED    = NO
WARN_IF_DOC_ERROR       = YES
WARN_AS_ERROR           = YES

HAVE_DOT               = NO
QUIET                  = NO
